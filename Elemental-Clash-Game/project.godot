; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Elemental Clash"
config/description="2-Player local card game with elemental mechanics"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/GameManager.gd"
DatabaseManager="*res://scripts/DatabaseManager.gd"
APIManager="*res://scripts/APIManager.gd"
AudioManager="*res://scripts/AudioManager.gd"
SaveManager="*res://scripts/SaveManager.gd"
ConfigManager="*res://scripts/ConfigManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[global]

Music=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
